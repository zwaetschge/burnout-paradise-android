<?xml version="1.0" encoding="utf-8"?>
<!--
  Burnout Paradise Remastered -> Android arm64-v8a
  A17: host shell manifest.

  No game code, assets or license data are embedded in the APK. The native
  front end (jni/port_main.c, libport_main.so) dlopen()s the locally built
  libburnout_static.so from the app lib directory at runtime; the user has to
  copy their own game files to
    /sdcard/Android/data/dev.plum.burnoutport/files/BurnoutPR
  Nothing is downloaded, nothing is unpacked from the APK.

  Required/optional features:
    * Vulkan 1.1 is required (DXVK d3d11/dxgi render through it).
    * GLES2 is *not* required: it is only used for the shell's liveness
      heartbeat when the static image does not take the window.
    * Gamepad is optional; touch and keyboard always work.
    * extractNativeLibs=true: the .so files are unpacked from the APK so the
      linker can map them normally (16 KB page aligned, see tools/build_apk.sh).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.plum.burnoutport"
    android:versionCode="2"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="36" />

    <uses-feature android:name="android.hardware.vulkan.version"
        android:version="0x00401000" android:required="true" />
    <uses-feature android:glEsVersion="0x00020000" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="true" />

    <!-- Only needed so the shell can stat() the game data directory. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:hasCode="false"
        android:debuggable="true"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:allowBackup="false"
        android:resizeableActivity="false"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|touchscreen|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection|colorMode|mcc|mnc|fontWeightAdjustment|grammaticalGender"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

            <meta-data android:name="android.app.lib_name" android:value="port_main" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
