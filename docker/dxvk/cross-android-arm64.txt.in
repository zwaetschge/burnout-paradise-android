# Meson cross file: DXVK (dxvk-native) for Android arm64-v8a, NDK r27, API 29.
# @NDK@ is replaced with $ANDROID_NDK_ROOT by docker/Dockerfile.builder.
[binaries]
c        = '@NDK@/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android29-clang'
cpp      = '@NDK@/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android29-clang++'
ar       = '@NDK@/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar'
strip    = '@NDK@/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-strip'
ranlib   = '@NDK@/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ranlib'
nm       = '@NDK@/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-nm'
objcopy  = '@NDK@/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-objcopy'
pkg-config = '/bin/false'
glslang  = 'glslangValidator'

[host_machine]
system     = 'android'
cpu_family = 'aarch64'
cpu        = 'aarch64'
endian     = 'little'

[properties]
needs_exe_wrapper = true
sys_root = '@NDK@/toolchains/llvm/prebuilt/linux-x86_64/sysroot'

[built-in options]
c_args        = ['-DANDROID', '-fPIC', '-fstack-protector-strong']
cpp_args      = ['-DANDROID', '-fPIC', '-fstack-protector-strong']
# 16 KiB page alignment for every PT_LOAD (Android 15+, 16K-page kernels)
c_link_args   = ['-Wl,-z,max-page-size=16384', '-Wl,-z,common-page-size=16384']
cpp_link_args = ['-Wl,-z,max-page-size=16384', '-Wl,-z,common-page-size=16384']
