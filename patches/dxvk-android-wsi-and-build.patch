+}
diff --git a/src/wsi/android/wsi_window_android.cpp b/src/wsi/android/wsi_window_android.cpp
new file mode 100644
index 0000000..6101d7e
--- /dev/null
+++ b/src/wsi/android/wsi_window_android.cpp
@@ -0,0 +1,211 @@
+#if defined(DXVK_WSI_ANDROID)
+
+#include "../wsi_window.h"
+
+#include "native/wsi/native_android.h"
+#include "wsi_platform_android.h"
+
+#include "../../util/util_string.h"
+#include "../../util/log/log.h"
+
+#include <windows.h>
+#include <android/native_window.h>
+
+namespace dxvk::wsi {
+
+  // Defined in wsi_platform_android.cpp.
+  void androidUpdateDisplayMetricsFromWindow(ANativeWindow* pWindow);
+
+  void AndroidWsiDriver::getWindowSize(
+        HWND      hWindow,
+        uint32_t* pWidth,
+        uint32_t* pHeight) {
+    ANativeWindow* window = fromHwnd(hWindow);
+
+    if (!window) {
+      Logger::err("Android WSI: getWindowSize: null window");
+      return;
+    }
+
+    androidUpdateDisplayMetricsFromWindow(window);
+
+    int32_t w = ANativeWindow_getWidth(window);
+    int32_t h = ANativeWindow_getHeight(window);
+
+    if (w < 0 || h < 0) {
+      Logger::err(str::format("Android WSI: getWindowSize: ANativeWindow_getWidth/Height failed"));
+      return;
+    }
+
+    if (pWidth)
+      *pWidth = uint32_t(w);
+
+    if (pHeight)
+      *pHeight = uint32_t(h);
+  }
+
+
+  void AndroidWsiDriver::resizeWindow(
+          HWND             hWindow,
+          DxvkWindowState* pState,
+          uint32_t         Width,
+          uint32_t         Height) {
+    ANativeWindow* window = fromHwnd(hWindow);
+
+    if (!window) {
+      Logger::err("Android WSI: resizeWindow: null window");
+      return;
+    }
+
+    // Format 0 keeps the current buffer format.
+    if (ANativeWindow_setBuffersGeometry(window, int32_t(Width), int32_t(Height), 0) != 0)
+      Logger::err(str::format("Android WSI: ANativeWindow_setBuffersGeometry(",
+        Width, "x", Height, ") failed"));
+  }
+
+
+  void AndroidWsiDriver::saveWindowState(
+            HWND             hWindow,
+            DxvkWindowState* pState,
+            bool             saveStyle) {
+    // The Android window/surface is owned by the Activity; there is no window
+    // style or geometry that DXVK could save or restore.
+  }
+
+
+  void AndroidWsiDriver::restoreWindowState(
+            HWND             hWindow,
+            DxvkWindowState* pState,
+            bool             restoreCoordinates) {
+    // Nothing to restore, see saveWindowState.
+  }
+
+
+  bool AndroidWsiDriver::setWindowMode(
+          HMONITOR         hMonitor,
+          HWND             hWindow,
+          DxvkWindowState* pState,
+    const WsiMode&         pMode) {
+    if (fromHmonitor(hMonitor) < 0)
+      return false;
+
+    pState->android.fullscreenMode = pMode;
+    return true;
+  }
+
+
+  bool AndroidWsiDriver::enterFullscreenMode(
+          HMONITOR         hMonitor,
+          HWND             hWindow,
+          DxvkWindowState* pState,
+          bool             ModeSwitch) {
+    // Android applications are always fullscreen; there is no display mode
+    // switch to perform and no window geometry to change.
+    return fromHmonitor(hMonitor) >= 0;
+  }
+
+
+  bool AndroidWsiDriver::leaveFullscreenMode(
+          HWND             hWindow,
+          DxvkWindowState* pState) {
+    return true;
+  }
+
+
+  bool AndroidWsiDriver::restoreDisplayMode() {
+    return true;
+  }
+
+
+  HMONITOR AndroidWsiDriver::getWindowMonitor(HWND hWindow) {
+    return fromHwnd(hWindow) ? toHmonitor(0) : nullptr;
+  }
+
+
+  bool AndroidWsiDriver::isWindow(HWND hWindow) {
+    return fromHwnd(hWindow) != nullptr;
+  }
+
+
+  bool AndroidWsiDriver::isMinimized(HWND hWindow) {
+    // Android has no "minimized" state that would be visible here; a
+    // destroyed surface shows up as a null window instead.
+    return false;
+  }
+
+
+  bool AndroidWsiDriver::isOccluded(HWND hWindow) {
+    return false;
+  }
+
+
+  void AndroidWsiDriver::updateFullscreenWindow(
+          HMONITOR hMonitor,
+          HWND     hWindow,
+          bool     forceTopmost) {
+    // Nothing to do, see enterFullscreenMode.
+  }
+
+
+  VkResult AndroidWsiDriver::createSurface(
+          HWND                      hWindow,
+          PFN_vkGetInstanceProcAddr pfnVkGetInstanceProcAddr,
+          VkInstance                instance,
+          VkSurfaceKHR*             pSurface) {
+    ANativeWindow* window = fromHwnd(hWindow);
+
+    if (!window) {
+      Logger::err("Android WSI: createSurface: null window");
+      return VK_ERROR_INITIALIZATION_FAILED;
+    }
+
+    if (!pfnVkGetInstanceProcAddr) {
+      Logger::err("Android WSI: createSurface: no vkGetInstanceProcAddr");
+      return VK_ERROR_INITIALIZATION_FAILED;
+    }
+
+#if defined(DXVK_WSI_HEADLESS)
+    auto pfnCreateHeadlessSurface = reinterpret_cast<PFN_vkCreateHeadlessSurfaceEXT>(
+      pfnVkGetInstanceProcAddr(instance, "vkCreateHeadlessSurfaceEXT"));
+
+    if (!pfnCreateHeadlessSurface) {
+      Logger::err("Android WSI (headless): vkCreateHeadlessSurfaceEXT not available");
+      return VK_ERROR_EXTENSION_NOT_PRESENT;
+    }
+
+    androidUpdateDisplayMetricsFromWindow(window);
+
+    VkHeadlessSurfaceCreateInfoEXT headlessInfo = { VK_STRUCTURE_TYPE_HEADLESS_SURFACE_CREATE_INFO_EXT };
+    VkResult headlessResult = pfnCreateHeadlessSurface(instance, &headlessInfo, nullptr, pSurface);
+
+    if (headlessResult != VK_SUCCESS)
+      Logger::err(str::format("Android WSI (headless): vkCreateHeadlessSurfaceEXT failed: ", headlessResult));
+
+    return headlessResult;
+#else
+    auto pfnCreateAndroidSurface = reinterpret_cast<PFN_vkCreateAndroidSurfaceKHR>(
+      pfnVkGetInstanceProcAddr(instance, "vkCreateAndroidSurfaceKHR"));
+
+    if (!pfnCreateAndroidSurface) {
+      Logger::err("Android WSI: vkCreateAndroidSurfaceKHR not available");
+      return VK_ERROR_EXTENSION_NOT_PRESENT;
+    }
+
+    androidUpdateDisplayMetricsFromWindow(window);
+
+    VkAndroidSurfaceCreateInfoKHR info = { VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR };
+    info.flags  = 0;
+    info.window = window;
+
+    VkResult result = pfnCreateAndroidSurface(instance, &info, nullptr, pSurface);
+
+    if (result != VK_SUCCESS)
+      Logger::err(str::format("Android WSI: vkCreateAndroidSurfaceKHR failed: ", result));
+
+    return result;
+#endif
+  }
+
+}
+
+#endif
