diff --git a/include/native/wsi/native_android.h b/include/native/wsi/native_android.h
new file mode 100644
index 0000000..6320760
--- /dev/null
+++ b/include/native/wsi/native_android.h
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <windows.h>
+
+#include <android/native_window.h>
+
+namespace dxvk::wsi {
+
+  // On Android the "window handle" handed to DXVK is the ANativeWindow of the
+  // Activity's Surface. DXVK never dereferences it itself, it only hands it to
+  // the WSI driver, so a plain pointer cast is enough.
+  inline ANativeWindow* fromHwnd(HWND hWindow) {
+    return reinterpret_cast<ANativeWindow*>(hWindow);
+  }
+
+  inline HWND toHwnd(ANativeWindow* pWindow) {
+    return reinterpret_cast<HWND>(pWindow);
+  }
+
+  // Android exposes exactly one (default) display, id 0. Offset by one so that
+  // display 0 maps to a non-null HMONITOR and "no monitor" (nullptr) maps to
+  // -1, matching the convention used by the SDL3 backend.
+  inline int32_t fromHmonitor(HMONITOR hMonitor) {
+    return int32_t(intptr_t(hMonitor)) - 1;
+  }
+
+  inline HMONITOR toHmonitor(int32_t displayId) {
+    return reinterpret_cast<HMONITOR>(intptr_t(displayId + 1));
+  }
+
+}
