diff --git a/src/wsi/android/wsi_monitor_android.cpp b/src/wsi/android/wsi_monitor_android.cpp
new file mode 100644
index 0000000..259496c
--- /dev/null
+++ b/src/wsi/android/wsi_monitor_android.cpp
@@ -0,0 +1,117 @@
+#if defined(DXVK_WSI_ANDROID)
+
+#include "../wsi_monitor.h"
+
+#include "native/wsi/native_android.h"
+#include "wsi_platform_android.h"
+
+#include "../../util/util_string.h"
+#include "../../util/log/log.h"
+
+#include <windows.h>
+
+namespace dxvk::wsi {
+
+  HMONITOR AndroidWsiDriver::getDefaultMonitor() {
+    return enumMonitors(0);
+  }
+
+
+  HMONITOR AndroidWsiDriver::enumMonitors(uint32_t index) {
+    // Android has exactly one default display.
+    return index == 0 ? toHmonitor(0) : nullptr;
+  }
+
+
+  HMONITOR AndroidWsiDriver::enumMonitors(const LUID *adapterLUID[], uint32_t numLUIDs, uint32_t index) {
+    return enumMonitors(index);
+  }
+
+
+  bool AndroidWsiDriver::getDisplayName(
+          HMONITOR         hMonitor,
+          WCHAR            (&Name)[32]) {
+    if (fromHmonitor(hMonitor) != 0)
+      return false;
+
+    static const WCHAR s_name[] = L"\\\\.\\DISPLAY1";
+
+    std::memset(Name, 0, sizeof(Name));
+    std::memcpy(Name, s_name, sizeof(s_name));
+
+    return true;
+  }
+
+
+  bool AndroidWsiDriver::getDesktopCoordinates(
+          HMONITOR         hMonitor,
+          RECT*            pRect) {
+    if (fromHmonitor(hMonitor) != 0)
+      return false;
+
+    const auto metrics = androidGetDisplayMetrics();
+
+    pRect->left   = 0;
+    pRect->top    = 0;
+    pRect->right  = LONG(metrics.width);
+    pRect->bottom = LONG(metrics.height);
+
+    return metrics.width && metrics.height;
+  }
+
+
+  static void fillMode(const AndroidDisplayMetrics& metrics, WsiMode* pMode) {
+    pMode->width        = metrics.width;
+    pMode->height       = metrics.height;
+    pMode->refreshRate  = metrics.refreshRate;
+    pMode->bitsPerPixel = metrics.bitsPerPixel;
+    pMode->interlaced   = false;
+  }
+
+
+  bool AndroidWsiDriver::getDisplayMode(
+          HMONITOR         hMonitor,
+          uint32_t         ModeNumber,
+          WsiMode*         pMode) {
+    // Only the current desktop mode is reported; Android does not let an
+    // application enumerate display modes.
+    if (fromHmonitor(hMonitor) != 0 || ModeNumber != 0)
+      return false;
+
+    return getDesktopDisplayMode(hMonitor, pMode);
+  }
+
+
+  bool AndroidWsiDriver::getCurrentDisplayMode(
+          HMONITOR         hMonitor,
+          WsiMode*         pMode) {
+    return getDesktopDisplayMode(hMonitor, pMode);
+  }
+
+
+  bool AndroidWsiDriver::getDesktopDisplayMode(
+          HMONITOR         hMonitor,
+          WsiMode*         pMode) {
+    if (fromHmonitor(hMonitor) != 0)
+      return false;
+
+    const auto metrics = androidGetDisplayMetrics();
+
+    if (!metrics.width || !metrics.height)
+      return false;
+
+    fillMode(metrics, pMode);
+    return true;
+  }
+
+
+  WsiEdidData AndroidWsiDriver::getMonitorEdid(HMONITOR hMonitor) {
+    // No EDID is available through the NDK. DXVK treats an empty EDID as
+    // "unknown monitor" and falls back to its own HDR heuristics.
+    Logger::warn("Android WSI: getMonitorEdid is not available on this platform.");
+    return {};
+  }
+
+}
+
+#endif
diff --git a/src/wsi/android/wsi_platform_android.cpp b/src/wsi/android/wsi_platform_android.cpp
new file mode 100644
index 0000000..cbc9493
--- /dev/null
+++ b/src/wsi/android/wsi_platform_android.cpp
@@ -0,0 +1,95 @@
+#if defined(DXVK_WSI_ANDROID)
+
+#include "wsi_platform_android.h"
+
+#include "../../util/util_error.h"
+#include "../../util/util_string.h"
+#include "../../util/log/log.h"
+
+#include <android/native_window.h>
+
+namespace dxvk::wsi {
+
+  static AndroidDisplayMetrics s_displayMetrics;
+
+  AndroidDisplayMetrics androidGetDisplayMetrics() {
+    return s_displayMetrics;
+  }
+
+  void androidSetDisplayMetrics(
+          uint32_t width,
+          uint32_t height,
+          uint32_t refreshNumerator,
+          uint32_t refreshDenominator) {
+    s_displayMetrics.width  = width;
+    s_displayMetrics.height = height;
+
+    if (refreshNumerator && refreshDenominator) {
+      s_displayMetrics.refreshRate = WsiRational {
+        refreshNumerator, refreshDenominator };
+    }
+  }
+
+  // Called by the window functions as soon as a real ANativeWindow shows up,
+  // so that monitor queries report the actual surface size instead of zero.
+  void androidUpdateDisplayMetricsFromWindow(ANativeWindow* pWindow) {
+    if (!pWindow || s_displayMetrics.width)
+      return;
+
+    int32_t w = ANativeWindow_getWidth(pWindow);
+    int32_t h = ANativeWindow_getHeight(pWindow);
+
+    if (w > 0 && h > 0) {
+      s_displayMetrics.width  = uint32_t(w);
+      s_displayMetrics.height = uint32_t(h);
+    }
+  }
+
+  AndroidWsiDriver::AndroidWsiDriver() {
+#if defined(DXVK_WSI_HEADLESS)
+    Logger::info("Android WSI (headless host build): using VK_EXT_headless_surface");
+#else
+    Logger::info("Android WSI: using ANativeWindow surfaces via vkCreateAndroidSurfaceKHR");
+#endif
+  }
+
+  AndroidWsiDriver::~AndroidWsiDriver() { }
+
+  std::vector<const char *> AndroidWsiDriver::getInstanceExtensions() {
+#if defined(DXVK_WSI_HEADLESS)
+    return { VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME };
+#else
+    return { VK_KHR_ANDROID_SURFACE_EXTENSION_NAME };
+#endif
+  }
+
+  static bool createAndroidWsiDriver(WsiDriver **driver) {
+    try {
+      *driver = new AndroidWsiDriver();
+    } catch (const DxvkError& e) {
+      Logger::err(str::format(e.message()));
+      return false;
+    }
+    return true;
+  }
+
+  WsiBootstrap AndroidWSI = {
+    "Android",
+    createAndroidWsiDriver
+  };
+
+}
+
+// Stable C entry point for the embedding application (our Android guest
+// runtime). Exported from libdxvk_d3d11.so / libdxvk_dxgi.so through the
+// version scripts.
+extern "C" void dxvk_android_wsi_set_display_metrics(
+        uint32_t width,
+        uint32_t height,
+        uint32_t refreshNumerator,
+        uint32_t refreshDenominator) {
+  dxvk::wsi::androidSetDisplayMetrics(
+    width, height, refreshNumerator, refreshDenominator);
+}
+
+#endif
diff --git a/src/wsi/android/wsi_platform_android.h b/src/wsi/android/wsi_platform_android.h
new file mode 100644
index 0000000..708d5c7
--- /dev/null
+++ b/src/wsi/android/wsi_platform_android.h
@@ -0,0 +1,125 @@
+#pragma once
+
+#include "../wsi_platform.h"
+
+namespace dxvk::wsi {
+
+  /**
+   * \brief Display metrics reported to D3D/DXGI
+   *
+   * Android has no portable refresh-rate query below API level 30, so the
+   * refresh rate defaults to 60/1 - the same fallback DXVK's SDL3 backend uses
+   * when the platform reports nothing (see wsi_platform_sdl3.h, convertMode).
+   * Width/height are filled in from the first ANativeWindow the driver sees
+   * and can be overridden explicitly by the embedding application.
+   */
+  struct AndroidDisplayMetrics {
+    uint32_t    width        = 0;
+    uint32_t    height       = 0;
+    WsiRational refreshRate  = { 60, 1 };
+    uint32_t    bitsPerPixel = 32;
+  };
+
+  AndroidDisplayMetrics androidGetDisplayMetrics();
+
+  class AndroidWsiDriver : public WsiDriver {
+  public:
+    AndroidWsiDriver();
+    ~AndroidWsiDriver();
+
+    // Platform
+    virtual std::vector<const char *> getInstanceExtensions();
+
+    // Monitor
+    virtual HMONITOR getDefaultMonitor();
+
+    virtual HMONITOR enumMonitors(uint32_t index);
+
+    virtual HMONITOR enumMonitors(const LUID *adapterLUID[], uint32_t numLUIDs, uint32_t index);
+
+    virtual bool getDisplayName(
