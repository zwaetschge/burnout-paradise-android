diff --git a/include/native/headless/android/native_window.h b/include/native/headless/android/native_window.h
new file mode 100644
index 0000000..a4c9b30
--- /dev/null
+++ b/include/native/headless/android/native_window.h
@@ -0,0 +1,31 @@
+#pragma once
+/* Host stand-in for the NDK's <android/native_window.h>, used only by the
+ * headless WSI build (DXVK_WSI_HEADLESS): the "window" is a size record owned
+ * by the embedding application and the Vulkan surface is a
+ * VK_EXT_headless_surface. No pixels are ever shown. */
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct ANativeWindow {
+  int32_t width;
+  int32_t height;
+  int32_t format;
+} ANativeWindow;
+static inline int32_t ANativeWindow_getWidth(ANativeWindow* window) {
+  return window ? window->width : -1;
+}
+static inline int32_t ANativeWindow_getHeight(ANativeWindow* window) {
+  return window ? window->height : -1;
+}
+static inline int32_t ANativeWindow_setBuffersGeometry(
+    ANativeWindow* window, int32_t width, int32_t height, int32_t format) {
+  if (!window) return -1;
+  if (width > 0)  window->width = width;
+  if (height > 0) window->height = height;
+  if (format)     window->format = format;
+  return 0;
+}
+#ifdef __cplusplus
+}
+#endif
